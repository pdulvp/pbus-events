[Unit]
Description=pbus - system event dispatcher
Documentation=man:pbus(1) man:pbusd(8)
After=network.target
# RuntimeDirectory creates /run/pbus before the daemon starts.

[Service]
Type=simple
ExecStart=/usr/sbin/pbusd --foreground
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=2
RuntimeDirectory=pbus
RuntimeDirectoryMode=0755
StateDirectory=pbus
StateDirectoryMode=0750
# No LogsDirectory=: systemd would reset the owner and mode of /var/log/pbus
# at every start, and the log is deliberately 0750 root:adm. The directory
# comes from tmpfiles.d, and pbusd creates the file itself 0640.
KillMode=mixed
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
